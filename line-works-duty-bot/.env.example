# ===========================================
# LINE WORKS Bot 設定
# ===========================================

# LINE WORKS API 2.0 認証情報
# Developer Console (https://dev.worsmobile.com) から取得
LINEWORKS_CLIENT_ID=your_client_id
LINEWORKS_CLIENT_SECRET=your_client_secret
LINEWORKS_SERVICE_ACCOUNT=your_service_account_id
LINEWORKS_PRIVATE_KEY_PATH=./private_key.pem

# Bot ID (Developer Console > Bot で確認)
LINEWORKS_BOT_ID=your_bot_id

# 当直表の写真を受け取るトークルームのチャンネルID
SOURCE_CHANNEL_ID=source_channel_id

# カレンダー登録先のトークルームのカレンダーID
TARGET_CALENDAR_ID=target_calendar_id

# Google Cloud Vision API (OCR用)
GOOGLE_APPLICATION_CREDENTIALS=./google_credentials.json

# サーバー設定
FLASK_PORT=8443
FLASK_DEBUG=false

# Webhook 検証トークン (LINE WORKS Developer Console で設定)
WEBHOOK_VERIFICATION_TOKEN=your_verification_token
